# Core paths
MARKET_PARSER_DB_PATH=data/market_parser.sqlite
MARKET_PARSER_EXPORT_DIR=exports
MARKET_PARSER_TIMEZONE=Europe/Moscow

# Collection defaults
MARKET_PARSER_CATEGORY_NAME=Детское питание
MARKET_PARSER_MAX_ITEMS_PER_STORE=2000
MARKET_PARSER_USE_BROWSER=true
MARKET_PARSER_PAGE_DELAY_SECONDS=2.0
MARKET_PARSER_STORE_DELAY_SECONDS=15.0

# Telegram bot (daily XLSX delivery). Create a bot via @BotFather to get the token.
# To find your chat id: message the bot, then run `market-parser telegram-chat-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets. Share the target spreadsheet with the service account email.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Витрина_30д
GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternative to GOOGLE_SERVICE_ACCOUNT_FILE:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
